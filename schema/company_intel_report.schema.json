{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/sales-champion-assistant/report.schema.json",
  "title": "SalesChampionAssistantReport",
  "type": "object",
  "required": [
    "company_name",
    "benchmark_date",
    "strategic_keywords",
    "enterprise_info",
    "resource_matching",
    "communication_guides",
    "unknowns",
    "evidence"
  ],
  "properties": {
    "company_name": { "type": "string" },
    "benchmark_date": { "type": "string" },
    "strategic_keywords": {
      "type": "array",
      "items": { "type": "string" }
    },
    "enterprise_info": {
      "type": "object",
      "required": [
        "overall_rating",
        "gtm_fact_check",
        "sensitivity_check",
        "veto_check",
        "star_rating",
        "recruiting_salary_analysis"
      ],
      "properties": {
        "overall_rating": { "$ref": "#/$defs/noteBlock" },
        "gtm_fact_check": { "$ref": "#/$defs/noteBlock" },
        "sensitivity_check": { "$ref": "#/$defs/noteBlock" },
        "veto_check": { "$ref": "#/$defs/noteBlock" },
        "star_rating": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/noteBlock" }
        },
        "recruiting_salary_analysis": { "$ref": "#/$defs/noteBlock" }
      },
      "additionalProperties": true
    },
    "resource_matching": {
      "type": "array",
      "items": { "$ref": "#/$defs/noteBlock" }
    },
    "communication_guides": {
      "type": "array",
      "items": { "$ref": "#/$defs/noteBlock" }
    },
    "unknowns": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["claim", "source_title", "source_url", "confidence"],
        "properties": {
          "claim": { "type": "string" },
          "source_title": { "type": "string" },
          "source_url": { "type": "string" },
          "confidence": {
            "type": "string",
            "enum": ["high", "medium", "low"]
          }
        },
        "additionalProperties": true
      }
    }
  },
  "$defs": {
    "noteBlock": {
      "type": "object",
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
